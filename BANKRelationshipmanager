 const d=say('bot',`<b>Validation complete.</b> ${r.length-bad.length} of ${r.length} documents verified.<div class="card"><h3>Document verification</h3>${r.map(x=>`<div class="row"><div>${x.d[0]}<small>${x.d[1]}</small>${x.issues.map(i=>`<small style="color:var(--bad)">${i}</small>`).join('')}</div><span class="tag ${x.ok?'t-ok':'t-bad'}">${x.ok?'Verified':'Failed'}</span></div>`).join('')}
